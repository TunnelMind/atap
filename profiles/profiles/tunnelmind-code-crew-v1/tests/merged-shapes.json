{
  "description": "code_crew:merged payload shapes. A PR merge (merge_kind absent or pr) needs owner/repo + pr_number and is anchored; a local merge (merge_kind local) names the repo basename, carries no pr_number and is asserted, since no third party can check a private local repo. CI asserts every must_accept case validates and every must_reject case fails the profile schema.",
  "must_accept": [
    {
      "name": "pr_merge_without_merge_kind",
      "event": {
        "event_type": "code_crew:merged",
        "payload": {
          "timestamp": "2026-10-12T12:00:00Z",
          "merge_commit_sha": "0123456789abcdef0123456789abcdef01234567",
          "evidence": "anchored",
          "repo": "example-org/example-repo",
          "pr_number": 42
        }
      }
    },
    {
      "name": "pr_merge_with_merge_kind_pr",
      "event": {
        "event_type": "code_crew:merged",
        "payload": {
          "timestamp": "2026-10-12T12:00:00Z",
          "merge_commit_sha": "0123456789abcdef0123456789abcdef01234567",
          "merge_kind": "pr",
          "evidence": "anchored",
          "repo": "example-org/example-repo",
          "pr_number": 42
        }
      }
    },
    {
      "name": "local_merge_asserted",
      "event": {
        "event_type": "code_crew:merged",
        "payload": {
          "timestamp": "2026-10-12T12:00:00Z",
          "merge_commit_sha": "0123456789abcdef0123456789abcdef01234567",
          "merge_kind": "local",
          "evidence": "asserted",
          "repo": "tm-crawl"
        }
      }
    }
  ],
  "must_reject": [
