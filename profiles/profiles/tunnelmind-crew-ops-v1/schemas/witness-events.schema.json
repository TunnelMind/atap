{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tunnelmind.ai/atap/profiles/tunnelmind-crew-ops-v1/witness-events.schema.json",
  "title": "tunnelmind:crew_ops:v1 \u2014 Witness Event payloads",
  "description": "Binds each profile event_type to its payload schema. A conformant Witness Event MUST validate against BOTH the ATAP v0.1 base witness-event schema (the envelope: @context, id, hashes, signature) AND this schema (the event_type vocabulary and payload shape). Every payload sets additionalProperties:false \u2014 that is how this profile encodes the ATAP \u00a77.6 no-PII prohibition: a payload carrying a person's name, email, IP address or any other person-resolvable field has no permitted key for it and fails validation. Every other field is a closed enum, a small integer, an agent id pattern or a sha256 digest, so no field can carry free text.",
  "type": "object",
  "required": [
    "event_type",
    "payload"
  ],
  "properties": {
    "event_type": {
      "enum": [
        "crew_ops:autonomy_decision",
        "crew_ops:ratification",
        "crew_ops:intake_decision",
        "crew_ops:owner_command"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "crew_ops:autonomy_decision"
          }
        },
        "required": [
          "event_type"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/autonomy_decision"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "crew_ops:ratification"
          }
        },
        "required": [
          "event_type"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/ratification"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "crew_ops:intake_decision"
          }
        },
        "required": [
          "event_type"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/intake_decision"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "crew_ops:owner_command"
          }
        },
        "required": [
          "event_type"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/owner_command"
          }
        }
      }
    }
  ],
  "$defs": {
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "evidence": {
      "enum": [
        "asserted",
        "anchored",
        "witnessed"
      ],
      "description": "How strong the claim is. asserted: the agent says so. anchored: bound to something a verifier can look up (a DKIM-verified mail message id). witnessed: the witness observed it itself."
    },
    "agent": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^crew-[a-z0-9-]{1,59}$"
        },
        {
          "$ref": "#/$defs/agent_role"
        }
      ],
      "description": "A crew agent id (crew-<name>) or an agent role. No `@`, spaces or capitals, so it cannot carry a person's name or email."
    },
    "agent_role": {
      "enum": [
        "supervisor",
        "coder",
        "qa",
        "reviewer",
        "coordinator"
      ]
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "autonomy_decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "timestamp",
        "evidence",
        "agent",
        "class",
        "action",
        "decision",
        "target_sha256"
      ],
      "properties": {
        "timestamp": {
          "$ref": "#/$defs/timestamp"
        },
        "evidence": {
          "$ref": "#/$defs/evidence",
          "const": "asserted",
          "description": "The rails' own record of their decision."
        },
        "agent": {
          "$ref": "#/$defs/agent"
        },
        "class": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4,
          "description": "Autonomy class of the action. Class 4 (pay, transfer, account, secret, credential, dns, delete, prose) is never grantable: it appears only as a refusal."
        },
        "action": {
          "enum": [
            "propose",
            "deploy",
            "edit",
            "notify",
            "mail-command",
            "grant",
            "ratify",
            "pay",
            "transfer",
            "account",
            "secret",
            "credential",
            "dns",
            "delete",
            "prose"
          ],
          "description": "The action the rails decided on, as the crew records it (agent-crew autonomy.py). `grant` and `ratify` are the rails' own actions; a Class 4 action is named by the Class 4 word it matched. Closed: a new action needs a new profile version."
        },
        "decision": {
          "enum": [
            "allow",
            "refuse",
            "grant",
            "expired",
            "request",
            "approved",
            "rejected"
          ],
          "description": "As the rails' ledger writes it (`expired`, not `expire`)."
        },
        "target_sha256": {
          "$ref": "#/$defs/sha256",
          "description": "sha256 of the action's target (path, branch or subject)."
        },
        "reason_sha256": {
          "$ref": "#/$defs/sha256",
          "description": "sha256 of the rails' reason text, when there is one."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "class": {
                "const": 4
              }
            },
            "required": [
              "class"
            ]
          },
          "then": {
            "properties": {
              "decision": {
                "const": "refuse"
              }
            }
          }
        }
      ]
    },
    "ratification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "timestamp",
        "evidence",
        "role",
        "decision",
        "channel",
        "text_sha256"
      ],
      "properties": {
        "timestamp": {
          "$ref": "#/$defs/timestamp"
        },
        "evidence": {
          "enum": [
            "asserted",
            "anchored"
          ],
          "description": "anchored only for a mail ratification carrying a DKIM-verified message id; otherwise asserted."
        },
        "role": {
          "const": "owner",
          "description": "A human ratification records the role, never the person (ATAP \u00a77.6)."
        },
        "decision": {
          "enum": [
            "approved",
            "rejected"
          ]
        },
        "channel": {
          "enum": [
            "cli",
            "mail"
          ]
        },
        "text_sha256": {
          "$ref": "#/$defs/sha256",
          "description": "sha256 of the ratification text; the text itself is a user communication and stays out of the payload."
        },
        "dkim_message_id_sha256": {
          "$ref": "#/$defs/sha256",
          "description": "sha256 of the Message-ID of the DKIM-verified ratification mail."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "evidence": {
                "const": "anchored"
              }
            },
            "required": [
              "evidence"
            ]
          },
          "then": {
            "properties": {
              "channel": {
                "const": "mail"
              }
            },
            "required": [
              "dkim_message_id_sha256"
            ]
          }
        },
        {
          "if": {
            "required": [
              "dkim_message_id_sha256"
            ]
          },
          "then": {
            "properties": {
              "channel": {
                "const": "mail"
              }
            }
          }
        }
      ]
    },
    "intake_decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "timestamp",
        "evidence",
        "by",
        "source",
        "decision",
        "title_sha256",
        "route"
      ],
      "properties": {
        "timestamp": {
          "$ref": "#/$defs/timestamp"
        },
        "evidence": {
          "$ref": "#/$defs/evidence",
          "const": "asserted"
        },
        "by": {
          "anyOf": [
            {
              "enum": [
                "toolsmith",
                "coordinator"
              ]
            },
            {
              "type": "string",
              "pattern": "^crew-[a-z0-9-]{1,59}$"
            }
          ]
        },
        "source": {
          "enum": [
            "thinker",
            "scout"
          ]
        },
        "decision": {
          "enum": [
            "act",
            "park",
            "drop"
          ]
        },
        "title_sha256": {
          "$ref": "#/$defs/sha256",
          "description": "sha256 of the idea's title; the title is free text and stays out of the payload."
        },
        "route": {
          "enum": [
            "workstream",
            "inbox",
            ""
          ],
          "description": "Where an acted-on idea goes; empty when it is parked or dropped."
        }
      }
    },
    "owner_command": {
      "type": "object",
      "additionalProperties": false,
      "description": "A command the owner gave the crew (by mail through the secretary, or at the CLI) and what came of it. Not an autonomy decision: the owner is not an agent under the rails.",
      "required": [
        "timestamp",
        "evidence",
        "role",
        "command",
        "target_sha256",
        "channel",
        "outcome"
      ],
      "properties": {
        "timestamp": {
          "$ref": "#/$defs/timestamp"
        },
        "evidence": {
          "enum": [
            "asserted",
            "anchored"
          ],
          "description": "anchored for a mail command (the secretary DKIM-verified its Message-ID); asserted for a CLI command."
        },
        "role": {
          "const": "owner",
          "description": "An owner command records the role, never the person (ATAP \u00a77.6)."
        },
        "command": {
          "enum": [
            "crew_stop",
            "crew_start",
            "ratify_yes",
            "ratify_no"
          ],
          "description": "`crew stop <agent>`, `crew start <agent>`, `ratify yes <id>`, `ratify no <id>`. Closed: a new command needs a new profile version."
        },
        "target_sha256": {
          "$ref": "#/$defs/sha256",
          "description": "sha256 of the command's target: the agent id for crew_stop/crew_start, the ratify id for ratify_yes/ratify_no."
        },
        "channel": {
          "enum": [
            "mail",
            "cli"
          ]
        },
        "outcome": {
          "enum": [
            "done",
            "refused",
            "failed"
          ],
          "description": "done: the command took effect. refused: the crew declined it. failed: it was accepted but did not complete."
        },
        "message_sha256": {
          "$ref": "#/$defs/sha256",
          "description": "sha256 of the Message-ID of the DKIM-verified command mail; the Message-ID itself stays out of the payload."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "channel": {
                "const": "mail"
              }
            },
            "required": [
              "channel"
            ]
          },
          "then": {
            "properties": {
              "evidence": {
                "const": "anchored"
              }
            },
            "required": [
              "message_sha256"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "channel": {
                "const": "cli"
              }
            },
            "required": [
              "channel"
            ]
          },
          "then": {
            "properties": {
              "evidence": {
                "const": "asserted"
              }
            },
            "not": {
              "required": [
                "message_sha256"
              ]
            }
          }
        }
      ]
    }
  }
}
